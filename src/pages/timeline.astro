---
import Base from '../layouts/Base.astro';
import TimelineApp from '../components/TimelineApp.tsx';
import entities from '../data/entities.json';
import { ERAS, ERA_META } from '../lib/types';

const all = entities as any[];

const eraPayloads = ERAS.map((era) => {
  const events = all.filter((e) => e.type === 'event' && e.era === era);

  const byYear = new Map<number, any[]>();
  const undated: any[] = [];

  for (const e of events) {
    const dated = (e.dates || []).filter((d: any) => typeof d.year === 'number' && d.year > 0);
    const pick = dated.find((d: any) => d.era === era) || dated[0];
    if (!pick) {
      undated.push({ slug: e.slug, title: e.title });
      continue;
    }
    const item = { slug: e.slug, title: e.title, date: /月/.test(pick.text || '') ? String(pick.text).slice(0, 14) : undefined };
    if (!byYear.has(pick.year)) byYear.set(pick.year, []);
    byYear.get(pick.year)!.push(item);
  }

  const groups = [...byYear.entries()]
    .sort((a, b) => a[0] - b[0])
    .map(([year, items]) => ({ year, items }));

  undated.sort((a, b) => a.title.localeCompare(b.title, 'zh-Hans-CN'));

  const yearPages = all
    .filter((e) => e.type === 'date' && new RegExp(`^${era}\\d+年$`).test(e.title))
    .map((e) => ({ slug: e.slug, title: e.title, year: Number(e.title.match(/(\d+)年/)[1]) }))
    .sort((a, b) => a.year - b.year);

  // span comes from dated events; year pages are only an index and occasionally
  // contain outlier values, so they are used as a fallback when no event is dated
  const eventYears = groups.map((g) => g.year);
  const years = eventYears.length ? eventYears : yearPages.map((p) => p.year);
  const min = years.length ? Math.min(...years) : null;
  const max = years.length ? Math.max(...years) : null;
  const span = min === null ? '—' : min === max ? `${min} 年` : `${min} – ${max} 年`;

  const people = all
    .filter((e) => e.type === 'character' && e.era === era && e.image)
    .sort((a, b) => b.citedBy - a.citedBy)
    .slice(0, 10)
    .map((e) => ({ slug: e.slug, title: e.title, image: e.image }));

  return {
    era,
    span,
    blurb: ERA_META[era].blurb,
    events: events.length,
    dated: events.length - undated.length,
    groups,
    undated,
    yearPages,
    people,
  };
});

const totalDated = eraPayloads.reduce((n, e) => n + e.dated, 0);
const totalUndated = eraPayloads.reduce((n, e) => n + e.undated.length, 0);
---
<Base title="时代" description="按纪元组织的中洲历史年表：双树纪元、第一至第四纪元的重要事件，按年份或叙事顺序排列。">
  <section class="wrap" style="padding-top:clamp(2rem,4vw,3rem)">
    <div class="eyebrow">Chronicle</div>
    <h1 style="font-size:clamp(2rem,4vw,3rem);margin-top:.5rem">时代与年表</h1>
    <p class="lede" style="margin-top:.8rem">
      不同纪元的年份不在同一条数轴上，因此这里按纪元分轴排列。
      {totalDated} 个事件有确切年份；{totalUndated} 个事件原站没有给出年份，单列在各自纪元的末尾，按标题顺序呈现。
    </p>
  </section>

  <section class="wrap" style="padding-block:1.8rem 3.5rem">
    <TimelineApp client:load eras={eraPayloads} initial="第三纪元" />
  </section>
</Base>
