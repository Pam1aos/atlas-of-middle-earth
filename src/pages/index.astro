---
import Base from '../layouts/Base.astro';
import EntityCard from '../components/EntityCard.astro';
import MiniGraph from '../components/MiniGraph.tsx';
import stats from '../data/stats.json';
import entities from '../data/entities.json';
import { TYPE_META, ERAS, ERA_META, ERA_COLORS, typeMeta } from '../lib/types';

const all = entities as any[];

const typeCounts: Record<string, number> = stats.types as any;
const browseTypes = ['character', 'race', 'place', 'realm', 'event', 'item', 'work', 'culture']
  .filter((t) => typeCounts[t]);

const eraCounts: Record<string, number> = {};
for (const e of all) if (e.era) eraCounts[e.era] = (eraCounts[e.era] || 0) + 1;

const withImage = all.filter((e) => e.image);
const featured = ['阿拉贡', '甘道夫', '夏尔', '魔戒大战', '至尊戒', '洛汗']
  .map((t) => all.find((e) => e.title === t))
  .filter(Boolean);

const HERO_POOL = all
  .filter((e) => e.image && ['character', 'place', 'realm', 'item'].includes(e.type) && e.citedBy >= 60)
  .sort((a, b) => b.citedBy - a.citedBy)
  .slice(0, 140)
  .map((e) => ({ s: e.slug, t: e.title, im: e.image, ty: e.type, label: typeMeta(e.type).label, color: typeMeta(e.type).color }));

const FEATURE_POOL = all
  .filter((e) => e.image && ['character', 'place', 'realm', 'item', 'event'].includes(e.type))
  .sort((a, b) => b.citedBy - a.citedBy)
  .slice(0, 160)
  .map((e) => ({
    s: e.slug, t: e.title, en: e.english || '', im: e.image, er: e.era || '',
    su: (e.summary || '').slice(0, 110), label: typeMeta(e.type).label, color: typeMeta(e.type).color,
  }));

const heroImage = (all.find((e) => e.title === '阿拉贡') || withImage[0]) as any;

const fmt = (n: number) => n.toLocaleString('zh-CN');
---
<Base description={`中洲志：${fmt(stats.entities)} 条中洲条目、${fmt(stats.relations)} 条人物与地点关系，可检索、可漫游的托尔金世界档案。`}>

  <section class="hero wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">Atlas of Middle-earth · {fmt(stats.entities)} entries</div>
        <h1>
          中洲志
          <span class="hero-sub">a field guide to tolkien's world</span>
        </h1>
        <p class="lede">
          从魔戒中文维基整理而来的中洲世界档案。人物、种族、地点、势力、事件与物品被重新编排成可检索的条目，
          并以关系图谱把散落在正文里的血缘、效忠与征战连成一张网。
        </p>
        <div class="hero-actions">
          <a class="btn" href="/browse/">探索世界</a>

        </div>
        <div class="hero-pills">
          <a class="chip" href="/browse/?type=character">人物 {fmt(typeCounts.character)}</a>
          <a class="chip" href="/browse/?type=place">地点 {fmt(typeCounts.place)}</a>
          <a class="chip" href="/browse/?type=event">事件 {fmt(typeCounts.event)}</a>
          <a class="chip" href="/browse/?type=item">物品 {fmt(typeCounts.item)}</a>
        </div>
      </div>

      <div class="hero-card">
        <div class="hero-card__top">
          <span class="hero-card__dot" aria-hidden="true"></span>
          <div class="hero-card__tags" aria-hidden="true">
            <span>条目</span><span>关系</span><span>纪元</span>
          </div>
        </div>
        <div class="hero-card__body">
          <div class="hero-art">
            <svg class="blob" viewBox="0 0 400 420" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
              <ellipse cx="150" cy="120" rx="120" ry="96" fill="#5f8a3e" opacity=".55" />
              <ellipse cx="235" cy="185" rx="105" ry="120" fill="#86a05c" opacity=".45" />
              <ellipse cx="300" cy="300" rx="96" ry="78" fill="#c9a17c" opacity=".55" />
              <ellipse cx="140" cy="330" rx="120" ry="70" fill="#e0c6a4" opacity=".6" />
            </svg>
            <a class="hero-art__frame" id="hero-frame" href={`/entry/${encodeURIComponent(heroImage.slug)}/`}>
              <img id="hero-img" src={heroImage.image} alt={`${heroImage.title}的插图`} width="480" height="600" fetchpriority="high" />
            </a>
            <div class="hero-art__tag" id="hero-tag">
              <a id="hero-name" href={`/entry/${encodeURIComponent(heroImage.slug)}/`}>{heroImage.title}</a>
              <span class="tbadge" id="hero-type" style={`--tb:${typeMeta(heroImage?.type).color}`}>{typeMeta(heroImage?.type).label}</span>
            </div>
          </div>

          <div class="hero-meta">
            <div class="meta-block">
              <span class="meta-block__label">Entries</span>
              <strong class="meta-block__value">{fmt(stats.entities)}</strong>
              <span class="meta-block__note">正文条目</span>
            </div>
            <div class="meta-block">
              <span class="meta-block__label">Relations</span>
              <strong class="meta-block__value">{fmt(stats.relations)}</strong>
              <span class="meta-block__note">有出处的关系</span>
            </div>
            <div class="meta-block">
              <span class="meta-block__label">Span</span>
              <strong class="meta-block__value">{ERAS.length}</strong>
              <span class="meta-block__note">个纪元</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="eras-h">
    <div class="section-head">
      <div>
        <div class="eyebrow">Timeline</div>
        <h2 id="eras-h">五个时代，一部编年史</h2>
        <p>按数据库实际收录的纪年组织。纪元之间的年份不可直接并列，每个时代单独成轴。</p>
      </div>
      <a class="section-link" href="/timeline/">查看完整年表 →</a>
    </div>
    <div class="era-grid">
      {ERAS.map((era, idx) => (
        <a class="era-card" href={`/timeline/?era=${encodeURIComponent(era)}`} style={`--era:${ERA_COLORS[era]}`}>
          <div class="era-card__idx">ERA {String(idx + 1).padStart(2, '0')}</div>
          <h3>{era}</h3>
          <div class="era-card__span">{ERA_META[era].span}</div>
          <div class="era-card__count">
            <span class="tbadge">{fmt(eraCounts[era] || 0)} 条相关条目</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section wrap" aria-labelledby="types-h">
    <div class="section-head">
      <div>
        <div class="eyebrow">Collections</div>
        <h2 id="types-h">从哪一类开始？</h2>
        <p>每一类都来自真实条目计数，点开即按类型筛选。</p>
      </div>
      <a class="section-link" href="/browse/">进入百科 →</a>
    </div>
    <div class="type-grid">
      {browseTypes.map((t) => {
        const m = TYPE_META[t];
        return (
          <a class="type-card" href={`/browse/?type=${t}`}>
            <div class="type-card__top">
              <span class="type-card__glyph" style={`background:${m.color}`}>{m.glyph}</span>
              <span class="type-card__n">{fmt(typeCounts[t])}</span>
            </div>
            <h3>{m.label}</h3>
            <p>{m.blurb}</p>
          </a>
        );
      })}
    </div>
  </section>

  <section class="section wrap" aria-labelledby="featured-h">
    <div class="section-head">
      <div>
        <div class="eyebrow">Selected</div>
        <h2 id="featured-h">值得先读的六条</h2>
        <p>每次打开随机抽取六条，全部带插图，指向数据库里真实存在的条目。</p>
      </div>
    </div>
    <div class="feature-grid" id="feature-grid">
      {featured.map((e) => <EntityCard e={e} />)}
    </div>
  </section>

  <section class="section wrap" aria-labelledby="graph-h">
    <div class="section-head">
      <div>
        <div class="eyebrow">Knowledge graph</div>
        <h2 id="graph-h">关系不是装饰</h2>
        <p>
          这里的每条连线都来自条目的信息框字段——父亲、子嗣、种族、所属势力。
          拖拽、缩放，点开任意节点继续走。
        </p>
      </div>
      <button class="section-link" data-graph-focus>进入完整图谱 →</button>
    </div>
    <div class="graph-window">
      <MiniGraph client:visible src="/data/home-graph.json" height="480px" layout="cose" />
      <div class="graph-window__hint">拖动节点 · 滚轮缩放 · 点击进入条目</div>
      <button class="btn btn--ghost graph-window__cta" data-graph-focus>完整图谱</button>
    </div>
  </section>

  <script type="application/json" id="hero-pool" set:html={JSON.stringify(HERO_POOL)} />
  <script type="application/json" id="feature-pool" set:html={JSON.stringify(FEATURE_POOL)} />
  <script is:inline>
    (() => {
      const el = document.getElementById('feature-pool');
      const grid = document.getElementById('feature-grid');
      if (!el || !grid) return;
      let pool = [];
      try { pool = JSON.parse(el.textContent || '[]'); } catch { return; }
      if (pool.length < 6) return;
      // shuffle a copy and take six, so the selection differs on every visit
      const shuffled = pool.slice();
      for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }
      const picks = shuffled.slice(0, 6);
      const frag = document.createDocumentFragment();
      picks.forEach((e) => {
        const a = document.createElement('a');
        a.className = 'ecard';
        a.href = '/entry/' + encodeURIComponent(e.s) + '/';

        const media = document.createElement('div');
        media.className = 'ecard__media';
        const img = document.createElement('img');
        img.src = e.im;
        img.alt = e.t + ' — 魔戒中文维基插图';
        img.width = 480; img.height = 360;
        img.loading = 'lazy'; img.decoding = 'async';
        media.appendChild(img);

        const body = document.createElement('div');
        body.className = 'ecard__body';
        const row = document.createElement('div');
        row.className = 'row';
        row.style.gap = '.35rem';
        const badge = document.createElement('span');
        badge.className = 'tbadge';
        badge.style.setProperty('--tb', e.color);
        badge.textContent = e.label;
        row.appendChild(badge);
        if (e.er) {
          const era = document.createElement('span');
          era.className = 'tbadge';
          era.textContent = e.er;
          row.appendChild(era);
        }
        const h3 = document.createElement('h3');
        h3.className = 'ecard__title';
        h3.textContent = e.t;
        body.appendChild(row);
        body.appendChild(h3);
        if (e.en) {
          const en = document.createElement('div');
          en.className = 'ecard__en';
          en.textContent = e.en;
          body.appendChild(en);
        }
        if (e.su) {
          const sum = document.createElement('p');
          sum.className = 'ecard__sum';
          sum.textContent = e.su;
          body.appendChild(sum);
        }
        a.appendChild(media);
        a.appendChild(body);
        frag.appendChild(a);
      });
      grid.replaceChildren(frag);
    })();
  </script>
  <script is:inline>
    (() => {
      const el = document.getElementById('hero-pool');
      if (!el) return;
      let pool = [];
      try { pool = JSON.parse(el.textContent || '[]'); } catch { return; }
      if (!pool.length) return;
      const pick = pool[Math.floor(Math.random() * pool.length)];
      const img = document.getElementById('hero-img');
      const frame = document.getElementById('hero-frame');
      const name = document.getElementById('hero-name');
      const tag = document.getElementById('hero-type');
      if (!img || !frame || !name || !tag) return;
      img.src = pick.im;
      img.alt = pick.t + '的插图';
      frame.href = '/entry/' + encodeURIComponent(pick.s) + '/';
      name.textContent = pick.t;
      name.href = frame.href;
      tag.textContent = pick.label;
      tag.style.setProperty('--tb', pick.color);
    })();
  </script>

</Base>
