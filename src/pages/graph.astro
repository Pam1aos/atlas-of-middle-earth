---
import Base from '../layouts/Base.astro';
import GraphApp from '../components/GraphApp.tsx';
import entities from '../data/entities.json';

const lite = (entities as any[]).map((e) => ({
  slug: e.slug, title: e.title, english: e.english || '', type: e.type,
  era: e.era || '', image: e.image || null, summary: (e.summary || '').slice(0, 130),
}));
---
<Base
  title="关系图谱"
  description="可缩放、可展开的中洲关系图谱：血缘、效忠、统治与征战，逐条来自条目信息框。"
  hideFooter
>

  <GraphApp client:load entities={lite} />
</Base>

<style>
  .graph-intro { max-width: var(--page); }
</style>
