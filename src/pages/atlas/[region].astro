---
import Base from '../../layouts/Base.astro';
import EntityCard from '../../components/EntityCard.astro';
import { regions } from '../../lib/regions';

export async function getStaticPaths() {
  return [...regions.entries()].map(([name, list]) => ({
    params: { region: name },
    props: { name, list: [...list].sort((a: any, b: any) => b.citedBy - a.citedBy) },
  }));
}

const { name, list } = Astro.props as any;
const withImage = list.filter((e: any) => e.image).length;
---
<Base
  title={`${name} · 地理`}
  description={`${name}地区的 ${list.length} 个地点与势力，来自魔戒中文维基的分类整理。`}
>
  <section class="wrap" style="padding-top:clamp(1.6rem,3vw,2.4rem)">
    <nav class="crumbs" aria-label="面包屑">
      <a href="/atlas/">地理</a><span aria-hidden="true">/</span><span>{name}</span>
    </nav>
    <h1 style="font-size:clamp(1.8rem,4vw,2.8rem);margin-top:.6rem">{name}</h1>
    <p class="lede" style="margin-top:.6rem">
      {list.length} 处地点，{withImage} 处有插图。按被引用次数排序。
    </p>
  </section>

  <section class="wrap" style="padding-block:1.6rem 3rem">
    <div class="card-grid">
      {list.map((e: any) => <EntityCard e={e} />)}
    </div>
    <p style="margin-top:2rem">
      <a class="section-link" href="/browse/?type=place">在百科中查看全部地点 →</a>
    </p>
  </section>
</Base>
