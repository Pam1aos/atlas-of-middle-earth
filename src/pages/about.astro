---
import Base from '../layouts/Base.astro';
import stats from '../data/stats.json';
import entities from '../data/entities.json';

const all = entities as any[];
const noImage = all.filter((e) => !e.image).length;
const withFacts = all.filter((e) => e.factGroups?.length).length;
const withEra = all.filter((e) => e.era).length;
const fmt = (n: number) => n.toLocaleString('zh-CN');

const typeRows = Object.entries(stats.types as Record<string, number>).sort((a, b) => b[1] - a[1]);
const TYPE_LABEL: Record<string, string> = {
  character: '人物', race: '种族', place: '地点', realm: '势力', org: '组织', event: '事件',
  item: '物品', language: '语言', culture: '文化', music: '音乐', work: '作品', adaptation: '改编',
  lore: '研究', date: '年代', qa: '问答', disambig: '消歧义', misc: '其他',
};
const relRows = Object.entries(stats.relationTypes as Record<string, number>).sort((a, b) => b[1] - a[1]);
const REL_LABEL: Record<string, string> = {
  work: '出现于作品', residence: '居住于', race: '种族', family: '家族', child: '子嗣',
  culture: '文化', spouse: '配偶', parent: '父母', sibling: '兄弟姐妹', title: '头衔',
  member: '成员', located: '位于', place: '发生地点', inhabitant: '住民', event: '相关事件',
  contains: '包含', leader: '领袖', battle: '战役', owner: '所有者', creator: '制造者',
  correspondence: '通信', director: '导演', actor: '主演',
};
---
<Base title="关于" description="中洲志的资料来源与数据质量报告。">
  <section class="wrap" style="padding-top:clamp(2rem,4vw,3rem)">
    <div class="eyebrow">About & sources</div>
    <h1 style="font-size:clamp(2rem,4vw,3rem);margin-top:.5rem">关于这份档案</h1>
    <p class="lede" style="margin-top:.8rem">
      这是一个个人非商业项目，把魔戒中文维基的内容整理成可检索、可漫游的静态站点。
      它不是官方百科，也不试图替代原站。
    </p>
  </section>

  <section class="section wrap" id="source">
    <div class="section-head">
      <div>
        <div class="eyebrow">Source</div>
        <h2 style="font-size:1.6rem">原始来源</h2>
      </div>
    </div>
    <div class="prose" style="max-width:72ch">
      <p>
        全部条目与图片来自魔戒中文维基（灰机 wiki）：<a href="https://lotr.huijiwiki.com/wiki/%E9%A6%96%E9%A1%B5" target="_blank" rel="noopener noreferrer">lotr.huijiwiki.com</a>。
        数据快照时间为 2026-11-18，共 {fmt(stats.entities)} 个条目。
      </p>
      <p>
        条目文字与图片版权归魔戒中文维基贡献者及原作者所有，原站内容以 CC BY-SA 协议授权；
        本站只做整理、检索与可视化，如需转载或再利用请遵循原站授权条款。
      </p>
    </div>
  </section>

  <section class="section wrap" id="quality">
    <div class="section-head">
      <div>
        <div class="eyebrow">Quality report</div>
        <h2 style="font-size:1.6rem">数据质量报告</h2>
        <p>下面全部数字由构建脚本从数据中实际统计得出，不是估算。</p>
      </div>
    </div>

    <div class="hero-stats" style="margin-bottom:2rem">
      <div class="hero-stat"><strong>{fmt(stats.entities)}</strong><span>实体</span></div>
      <div class="hero-stat"><strong>{fmt(stats.relations)}</strong><span>关系</span></div>
      <div class="hero-stat"><strong>{fmt(withFacts)}</strong><span>含信息框</span></div>
      <div class="hero-stat"><strong>{fmt(stats.totalFacts)}</strong><span>结构化字段</span></div>
      <div class="hero-stat"><strong>{fmt(stats.aliases)}</strong><span>别名</span></div>
      <div class="hero-stat"><strong>{fmt(noImage)}</strong><span>缺图</span></div>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem">
      <div class="card" style="padding:1.2rem">
        <h3 style="font-size:1rem;margin-bottom:.6rem">实体分布</h3>
        <table style="width:100%;font-size:.86rem;border-collapse:collapse">
          {typeRows.map(([t, n]) => (
            <tr><td style="padding:.2rem 0;color:var(--muted)">{TYPE_LABEL[t] || t}</td><td style="text-align:right;font-variant-numeric:tabular-nums">{fmt(n)}</td></tr>
          ))}
        </table>
      </div>
      <div class="card" style="padding:1.2rem">
        <h3 style="font-size:1rem;margin-bottom:.6rem">关系分布</h3>
        <table style="width:100%;font-size:.86rem;border-collapse:collapse">
          {relRows.map(([t, n]) => (
            <tr><td style="padding:.2rem 0;color:var(--muted)">{REL_LABEL[t] || t}</td><td style="text-align:right;font-variant-numeric:tabular-nums">{fmt(n)}</td></tr>
          ))}
        </table>
      </div>
      <div class="card" style="padding:1.2rem">
        <h3 style="font-size:1rem;margin-bottom:.6rem">完整性检查</h3>
        <ul style="font-size:.86rem;line-height:2;padding-left:1.1rem;margin:0">
          <li>失效关系（端点不存在）：<strong>{stats.danglingRelations}</strong></li>
          <li>重复标题：<strong>{stats.dupeTitles}</strong></li>
          <li>带有纪元的实体：<strong>{fmt(withEra)}</strong></li>
          <li>缺少摘要：<strong>{stats.noSummary}</strong></li>
          <li>缺少原始链接：<strong>{stats.noSource}</strong></li>
          <li>引用图片但文件缺失：<strong>{stats.missingImageFiles}</strong></li>
        </ul>
      </div>
    </div>
  </section>
</Base>
