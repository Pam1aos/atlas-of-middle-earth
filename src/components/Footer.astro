---
import stats from '../data/stats.json';
import { SITE, NAV } from '../lib/site';

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/" style="margin-bottom:.9rem">
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-text">{SITE.name}<small>{SITE.nameEn}</small></span>
        </a>
        <p style="max-width:38ch;margin-top:.7rem;color:var(--ink-3);font-size:.86rem">
          个人整理的中洲世界档案：人物、地点、事件与关系图谱。
        </p>
      </div>
      <div class="footer-nav">
        <h4>浏览</h4>
        <nav class="footer-links">
          {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
      </div>
    </div>
    <div class="footer-note">
      <span>© {year} {SITE.name} · 个人非商业项目</span>
      <span>{stats.entities.toLocaleString('zh-CN')} 条目 · {stats.relations.toLocaleString('zh-CN')} 条关系</span>
    </div>
  </div>
</footer>
