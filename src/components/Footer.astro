---
import stats from '../data/stats.json';
import { SITE, NAV } from '../lib/site';

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/" style="margin-bottom:.8rem">
          <span class="brand-mark">中</span>
          <span>{SITE.name}<small>{SITE.nameEn}</small></span>
        </a>
        <p style="max-width:38ch;margin-top:.6rem">
          个人整理的中洲世界档案。全部条目、图片与关系均来自魔戒中文维基，
          本站只做结构化、检索与可视化。
        </p>
      </div>
      <div>
        <h4>浏览</h4>
        {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
      </div>
      <div>
        <h4>数据</h4>
        <a href="/about/">来源与覆盖范围</a>
        <a href="/about/#quality">数据质量报告</a>
        <a href="/about/#credits">图片署名</a>
        <a href="https://lotr.huijiwiki.com/wiki/%E9%A6%96%E9%A1%B5" target="_blank" rel="noopener noreferrer">魔戒中文维基 ↗</a>
      </div>
    </div>
    <div class="footer-note">
      <span>© {year} {SITE.name} · 个人非商业项目</span>
      <span>{stats.entities.toLocaleString('zh-CN')} 条目 · {stats.relations.toLocaleString('zh-CN')} 条关系 · 数据快照 2026-11-18</span>
    </div>
  </div>
</footer>
