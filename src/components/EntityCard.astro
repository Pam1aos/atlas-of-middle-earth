---
import { typeMeta } from '../lib/types';

interface Props {
  e: {
    slug: string; title: string; english?: string; type: string;
    summary?: string; image?: string | null; era?: string | null;
  };
  eager?: boolean;
}

const { e, eager = false } = Astro.props;
const meta = typeMeta(e.type);
const href = `/entry/${encodeURIComponent(e.slug)}/`;
---
<a class="ecard" href={href}>
  <div class="ecard__media">
    {e.image ? (
      <img
        src={e.image}
        alt={`${e.title} — 魔戒中文维基插图`}
        width="480" height="360"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <div class="ecard__placeholder" aria-hidden="true">{meta.glyph}</div>
    )}
  </div>
  <div class="ecard__body">
    <div class="row" style="gap:.35rem">
      <span class="tbadge" style={`--tb:${meta.color}`}>{meta.label}</span>
      {e.era && <span class="tbadge">{e.era}</span>}
    </div>
    <h3 class="ecard__title">{e.title}</h3>
    {e.english && <div class="ecard__en">{e.english}</div>}
    {e.summary && <p class="ecard__sum">{e.summary}</p>}
  </div>
</a>
