---
import '../styles/global.css';
import '../styles/pages.css';
import '../styles/hero-trees.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AgentDock from '../components/AgentDock.tsx';
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  hideFooter?: boolean;
}

const { title, description = SITE.description, image, noindex = false, hideFooter = false } = Astro.props;
const showTrees = !Astro.url.pathname.startsWith('/atlas') && !Astro.url.pathname.startsWith('/timeline');

const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.nameEn}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = image ? new URL(image, Astro.site ?? SITE.url).href : undefined;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f4f0e6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={`${SITE.name} · ${SITE.nameEn}`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE.name,
      alternateName: SITE.nameEn,
      url: (Astro.site ?? SITE.url).href,
      description: SITE.description,
      inLanguage: 'zh-CN',
    })} />
  </head>
  <body>
    <a href="#main" class="sr-only">跳到主要内容</a>
    {showTrees && (
      <div class="page-trees" aria-hidden="true">
        <span class="page-rainbow"></span>
        <img class="page-tree page-tree--left" src="/images/art/canopy-left.webp" alt="" width="760" height="577" />
        <img class="page-tree page-tree--right" src="/images/art/canopy-right.webp" alt="" width="760" height="576" />
        <span class="edge-zone edge-zone--left"></span>
        <span class="edge-zone edge-zone--right"></span>
        <div class="page-spark" aria-hidden="true">
          {Array.from({ length: 18 }).map((_, i) => (
            <span
              class="spark"
              style={`--x:${6 + (i * 23) % 26}%; --y:${(i * 41) % 92}%; --d:${(i % 6) * 0.32}s; --s:${0.55 + (i % 4) * 0.25}`}
            ></span>
          ))}
        </div>
      </div>
    )}
    <Header />
    <main id="main">
      <slot />
    </main>
    {!hideFooter && <Footer />}
    <AgentDock client:idle />
    <script is:inline>
    // hover near either page edge lights the star field over the canopies
    (() => {
      let raf = 0;
      const apply = (clientX) => {
        const w = window.innerWidth;
        document.body.classList.toggle('edge-hover', clientX < w * 0.18 || clientX > w * 0.82);
      };
      window.addEventListener('pointermove', (e) => {
        if (raf) return;
        raf = requestAnimationFrame(() => { raf = 0; apply(e.clientX); });
      }, { passive: true });
      window.addEventListener('pointerleave', () => document.body.classList.remove('edge-hover'));
    })();
  </script>
</body>
</html>
